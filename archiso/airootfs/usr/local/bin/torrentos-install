#!/usr/bin/env bash
#
# TorrentOS Installer
# Installs TorrentOS to disk with a fully guided setup wizard.
#
set -euo pipefail

RED='\033[1;31m'; GRN='\033[1;32m'; BLU='\033[1;34m'; YLW='\033[1;33m'
CYN='\033[38;2;91;192;235m'; DIM='\033[2;37m'; WHT='\033[1;37m'; RST='\033[0m'

log()  { printf "${BLU}[TorrentOS]${RST} %s\n" "$*"; }
ok()   { printf "${GRN}[  ok  ]${RST} %s\n" "$*"; }
warn() { printf "${YLW}[ warn ]${RST} %s\n" "$*"; }
err()  { printf "${RED}[ err  ]${RST} %s\n" "$*" >&2; }
step() { printf "\n${CYN}  ▸ %s${RST}\n" "$*"; }

_ver="$(grep '^TORRENTOS_VERSION=' /etc/torrentos/version 2>/dev/null | cut -d= -f2 | tr -d '"' || echo 0.5)"

printf "${BLU}"
cat <<'LOGO'

  ████████╗ ██████╗ ██████╗ ██████╗ ███████╗███╗   ██╗████████╗ ██████╗ ███████╗
     ██╔══╝██╔═══██╗██╔══██╗██╔══██╗██╔════╝████╗  ██║╚══██╔══╝██╔═══██╗██╔════╝
     ██║   ██║   ██║██████╔╝██████╔╝█████╗  ██╔██╗ ██║   ██║   ██║   ██║███████╗
     ██║   ██║   ██║██╔══██╗██╔══██╗██╔══╝  ██║╚██╗██║   ██║   ██║   ██║╚════██║
     ██║   ╚██████╔╝██║  ██║██║  ██║███████╗██║ ╚████║   ██║   ╚██████╔╝███████║
     ╚═╝    ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝╚══════╝╚═╝  ╚═══╝   ╚═╝    ╚═════╝ ╚══════╝

LOGO
printf "${RST}"
printf "${DIM}                     Install TorrentOS to Disk — v${_ver}${RST}\n\n"

# ── Must run as root ──────────────────────────────────────────────────────────
if [[ $EUID -ne 0 ]]; then
    err "This installer must run as root. Try: sudo torrentos-install"
    exit 1
fi

step "Checking system"

# Internal installer engine check — message is user-friendly, not technical
if ! command -v archinstall >/dev/null 2>&1; then
    err "TorrentOS installer is not available. Please use the official TorrentOS ISO."
    exit 1
fi
if ! command -v jq >/dev/null 2>&1; then
    err "A required component is missing. Please use the official TorrentOS ISO."
    exit 1
fi

# ── WiFi / internet check ─────────────────────────────────────────────────────
log "Checking internet connection..."
_check_internet() {
    curl -s --max-time 5 https://1.1.1.1 >/dev/null 2>&1 || \
    curl -s --max-time 5 https://google.com >/dev/null 2>&1
}

if _check_internet; then
    ok "Internet connected."
else
    warn "No internet connection detected."
    echo
    printf "${CYN}  ▸ WiFi Setup${RST}\n"
    echo
    log "Scanning for nearby WiFi networks..."
    nmcli device wifi list 2>/dev/null | head -20 || true
    echo
    printf "${DIM}  Opening network manager — choose your WiFi network, enter the password,${RST}\n"
    printf "${DIM}  then select Quit when connected.${RST}\n\n"
    sleep 1
    nmtui 2>/dev/null || true
    echo
    if _check_internet; then
        ok "Internet connected!"
    else
        warn "Still no internet — TorrentOS needs internet to install."
        printf "  Continue anyway? [y/N] "
        read -r ans
        [[ "$ans" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }
    fi
fi

# ── Hardware detection ────────────────────────────────────────────────────────
if [[ -d /sys/firmware/efi ]]; then
    ok "UEFI boot mode detected."
    BOOT_MODE="uefi"
else
    ok "Legacy BIOS boot mode detected."
    BOOT_MODE="bios"
fi

NVIDIA_DETECTED=false
if lspci 2>/dev/null | grep -qi nvidia; then
    NVIDIA_DETECTED=true
    ok "NVIDIA graphics card detected — drivers will be installed automatically."
fi

# ── Disk selection ────────────────────────────────────────────────────────────
step "Choose your install disk"
lsblk -o NAME,SIZE,MODEL,TYPE,MOUNTPOINTS -e 7,11 | grep -v "^loop"
echo

printf "${YLW}  ⚠  WARNING: Installation will PERMANENTLY ERASE the selected disk.${RST}\n"
printf "${YLW}     Back up all important data before continuing.${RST}\n"
echo
printf "  Ready to start? [y/N] "
read -r ans
[[ "$ans" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }

# ── Locate local TorrentOS package repo ──────────────────────────────────────
step "Locating TorrentOS packages"
LOCAL_REPO=""
for candidate in \
    "/run/archiso/bootmnt/repo/x86_64" \
    "/run/archiso/airootfs/repo/x86_64" \
    "/repo/x86_64" \
    "/opt/torrentos-repo/x86_64"
do
    if [[ -d "$candidate" ]] && ls "$candidate"/torrentos.db* >/dev/null 2>&1; then
        LOCAL_REPO="$candidate"
        break
    fi
done

# ── Guided account setup ──────────────────────────────────────────────────────
step "Create your user account"
printf "${DIM}  This will be your username and password on TorrentOS.${RST}\n\n"

# Username
while true; do
    printf "  ${WHT}Username${RST} (lowercase letters, numbers, underscores — no spaces): "
    read -r NEW_USERNAME
    [[ -z "$NEW_USERNAME" ]] && NEW_USERNAME="user"
    if [[ "$NEW_USERNAME" =~ ^[a-z_][a-z0-9_-]{0,30}$ ]]; then
        break
    fi
    warn "Username must start with a lowercase letter and only contain a-z, 0-9, _ or -"
done

# Password (hidden input, confirmation, minimum length)
while true; do
    printf "  ${WHT}Password${RST}: "
    read -rs NEW_PASS; echo
    if [[ ${#NEW_PASS} -lt 4 ]]; then
        warn "Password must be at least 4 characters."; continue
    fi
    printf "  ${WHT}Confirm password${RST}: "
    read -rs NEW_PASS2; echo
    if [[ "$NEW_PASS" == "$NEW_PASS2" ]]; then
        break
    fi
    warn "Passwords don't match — try again."
done

ok "Account: ${NEW_USERNAME}"
echo

# ── Timezone ──────────────────────────────────────────────────────────────────
step "Timezone"
printf "${DIM}  Common options:  Europe/London  America/New_York  America/Los_Angeles${RST}\n"
printf "${DIM}                   Europe/Berlin   Asia/Tokyo        Australia/Sydney${RST}\n\n"
printf "  ${WHT}Timezone${RST} [Europe/London]: "
read -r NEW_TIMEZONE
[[ -z "$NEW_TIMEZONE" ]] && NEW_TIMEZONE="Europe/London"
if [[ ! -f "/usr/share/zoneinfo/$NEW_TIMEZONE" ]]; then
    warn "Timezone '$NEW_TIMEZONE' not found — defaulting to Europe/London"
    NEW_TIMEZONE="Europe/London"
fi
ok "Timezone: ${NEW_TIMEZONE}"
echo

# ── Build installer config ────────────────────────────────────────────────────
CONF_DIR=$(mktemp -d /tmp/torrentos-install.XXXXX)
trap 'rm -rf "$CONF_DIR"' EXIT

EXTRA_PACKAGES=(
    # TorrentOS custom packages
    torrentos-base
    torrentos-theme
    torrentos-hyprland-config
    torrentos-first-boot
    torrentos-settings
    torrentos-tools
    # Python deps for settings app
    python
    python-gobject
    python-tomli-w
    # Fonts
    inter-font
    ttf-jetbrains-mono-nerd
    noto-fonts
    noto-fonts-emoji
    # System utils
    libnotify
    pacman-contrib
    papirus-icon-theme
    # Terminal & shell
    ghostty
    zsh
    zsh-completions
    starship
    btop
    htop
    bat
    eza
    fzf
    zoxide
    ripgrep
    fd
    tmux
    fastfetch
    # Desktop components
    waybar
    swaync
    rofi-wayland
    hyprpaper
    hypridle
    hyprlock
    hyprpicker
    nwg-dock-hyprland
    # Media
    playerctl
    pavucontrol
    pipewire
    pipewire-pulse
    pipewire-alsa
    wireplumber
    # Clipboard
    wl-clipboard
    cliphist
    wl-clip-persist
    # Bluetooth
    bluez
    bluez-utils
    blueman
    # Network
    networkmanager
    network-manager-applet
    # Display
    brightnessctl
    gammastep
    # Qt / GTK theming
    qt6ct
    kvantum
    gtk4
    libadwaita
    # Graphics tools
    grim
    slurp
    imv
    loupe
    # Files
    nautilus
    file-roller
    # Productivity
    gnome-text-editor
    gnome-calculator
    gnome-font-viewer
    # Gaming
    gamemode
    lib32-gamemode
    mangohud
    lib32-mangohud
    # Flatpak
    flatpak
    # Wayland compat
    xdg-desktop-portal-hyprland
    xdg-user-dirs
    # Accessibility
    magnus
    expac
    # Apps
    firefox
    qbittorrent
    mpv
    # Desktop integration
    polkit-gnome
    libinput-gestures
    nm-connection-editor
    xdg-desktop-portal-gtk
    neovim
)

if [[ "$NVIDIA_DETECTED" == "true" ]]; then
    EXTRA_PACKAGES+=(
        nvidia-dkms
        nvidia-utils
        lib32-nvidia-utils
        nvidia-settings
        nvidia-prime
        libva-nvidia-driver
    )
fi

ADD_REPOS="[]"
if [[ -n "$LOCAL_REPO" ]]; then
    ok "Found TorrentOS packages at: $LOCAL_REPO"
    ADD_REPOS="[{\"name\":\"torrentos\",\"url\":\"file://$LOCAL_REPO\",\"sign_check\":\"Never\",\"sign_option\":\"Never\"}]"
else
    warn "TorrentOS packages not found on live media — will download during install."
fi

PKG_JSON="$(printf '%s\n' "${EXTRA_PACKAGES[@]}" | jq -R . | jq -s .)"

# Build user JSON safely (jq handles special chars in password)
USER_JSON="$(jq -n \
    --arg u "$NEW_USERNAME" \
    --arg p "$NEW_PASS" \
    '[{"username":$u,"!password":$p,"sudo":true,"groups":["wheel","video","audio","input","storage","optical","network","power","sys","tty","lp"]}]')"

# Build post-install commands safely
CUSTOM_CMDS="$(jq -n \
    --arg u "$NEW_USERNAME" \
    '[ ("chsh -s /usr/bin/zsh " + $u + " 2>/dev/null || true"),
       "systemctl enable NetworkManager 2>/dev/null || true",
       "systemctl enable bluetooth 2>/dev/null || true",
       "systemctl enable fstrim.timer 2>/dev/null || true",
       "systemctl enable systemd-resolved 2>/dev/null || true",
       "flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true",
       "ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf 2>/dev/null || true"
    ]')"

GFX_DRIVER="All open-source (default)"
[[ "$NVIDIA_DETECTED" == "true" ]] && GFX_DRIVER="Nvidia"

jq -n \
    --argjson repos "$ADD_REPOS" \
    --argjson pkgs  "$PKG_JSON" \
    --argjson users "$USER_JSON" \
    --argjson cmds  "$CUSTOM_CMDS" \
    --arg tz  "$NEW_TIMEZONE" \
    --arg gfx "$GFX_DRIVER" \
'{
  "additional-repositories": $repos,
  "archinstall-language": "English",
  "bootloader": "Grub",
  "hostname": "torrentos",
  "kernels": ["linux"],
  "locale_config": { "kb_layout": "us", "sys_enc": "UTF-8", "sys_lang": "en_US" },
  "packages": $pkgs,
  "!users": $users,
  "profile_config": {
    "profile": { "custom_settings": {}, "details": ["Hyprland"], "main": "Desktop" },
    "gfx_driver": $gfx
  },
  "custom-commands": $cmds,
  "swap": true,
  "timezone": $tz
}' > "$CONF_DIR/user_configuration.json"

# ── Install TorrentOS ─────────────────────────────────────────────────────────
step "Installing TorrentOS to your disk"
log "This will take 10-20 minutes depending on your internet speed."
log "Please do not turn off your computer during installation."
echo

archinstall --config "$CONF_DIR/user_configuration.json"

# ── Post-install configuration ────────────────────────────────────────────────
step "Applying TorrentOS settings"

INSTALL_MNT="/mnt"
GREETD_DEST="$INSTALL_MNT/etc/greetd/config.toml"

# Configure login screen
if [[ -d "$INSTALL_MNT/etc/greetd" ]]; then
    log "Configuring login screen..."
    # --remember + --remember-user-session: after the first login the username
    # is pre-filled permanently — users only ever need to type their password.
    cat > "$GREETD_DEST" << 'GREETD_EOF'
# TorrentOS — login screen configuration.
# Username is remembered after first login — only password required each boot.

[terminal]
vt = 1

[default_session]
command = "tuigreet --time --remember --remember-user-session --asterisks --greeting 'Welcome to TorrentOS — enter your password' --cmd Hyprland"
user = "greeter"
GREETD_EOF
    ok "Login screen configured."

    # Pre-seed the username so it appears on the very first boot
    TUIGREET_STATE="$INSTALL_MNT/var/cache/tuigreet"
    mkdir -p "$TUIGREET_STATE"
    echo "$NEW_USERNAME" > "$TUIGREET_STATE/last_user"
    echo "Hyprland"      > "$TUIGREET_STATE/last_session"
    ok "Login screen pre-seeded — username: ${NEW_USERNAME}"
else
    warn "Login screen not found — greetd config not written."
fi

# Configure login security: 10 attempts allowed, then 5-minute lockout
log "Configuring login security..."
mkdir -p "$INSTALL_MNT/etc/security"
cat > "$INSTALL_MNT/etc/security/faillock.conf" << 'FAILLOCK_EOF'
# TorrentOS login security
# After 10 failed password attempts the account is locked for 5 minutes.
deny = 10
unlock_time = 300
fail_interval = 900
silent = false
audit = true
FAILLOCK_EOF
ok "Login security: 10 attempts allowed, 5-minute lockout after that."

echo
ok "TorrentOS installed successfully!"
printf "\n  ${GRN}➜${RST}  Remove the USB drive and reboot into your new system:\n"
printf "\n     ${CYN}reboot${RST}\n\n"
printf "${CYN}  On the login screen your username (${WHT}${NEW_USERNAME}${CYN}) will already be filled in.\n"
printf "  Just type your password and press Enter — every single time you boot.${RST}\n\n"
printf "${DIM}  Security: after 10 wrong password attempts, login is locked for 5 minutes.${RST}\n\n"
printf "${CYN}  After first login, the TorrentOS setup wizard guides you through\n"
printf "  WiFi, keyboard layout, timezone, and browser selection.${RST}\n\n"
