#!/usr/bin/env bash
#
# TorrentOS Disk Installer
# Wraps archinstall with TorrentOS defaults and a guided pre-flight check.
# Also copies the local TorrentOS package repo into the installed system so
# TorrentOS-specific packages (settings, tools, hyprland-config, etc.) are
# available on first boot.
#
set -euo pipefail

RED='\033[1;31m'; GRN='\033[1;32m'; BLU='\033[1;34m'; YLW='\033[1;33m'
CYN='\033[38;2;91;192;235m'; DIM='\033[2;37m'; RST='\033[0m'

log()  { printf "${BLU}[install]${RST} %s\n" "$*"; }
ok()   { printf "${GRN}[  ok  ]${RST} %s\n" "$*"; }
warn() { printf "${YLW}[ warn ]${RST} %s\n" "$*"; }
err()  { printf "${RED}[ err  ]${RST} %s\n" "$*" >&2; }
step() { printf "\n${CYN}  ▸ %s${RST}\n" "$*"; }

_ver="$(grep '^TORRENTOS_VERSION=' /etc/torrentos/version 2>/dev/null | cut -d= -f2 | tr -d '"' || echo 0.5)"

printf "${BLU}"
cat <<'LOGO'

  ████████╗ ██████╗ ██████╗ ██████╗ ███████╗███╗   ██╗████████╗ ██████╗ ███████╗
     ██╔══╝██╔═══██╗██╔══██╗██╔══██╗██╔════╝████╗  ██║╚══██╔══╝██╔═══██╗██╔════╝
     ██║   ██║   ██║██████╔╝██████╔╝█████╗  ██╔██╗ ██║   ██║   ██║   ██║███████╗
     ██║   ██║   ██║██╔══██╗██╔══██╗██╔══╝  ██║╚██╗██║   ██║   ██║   ██║╚════██║
     ██║   ╚██████╔╝██║  ██║██║  ██║███████╗██║ ╚████║   ██║   ╚██████╔╝███████║
     ╚═╝    ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝╚══════╝╚═╝  ╚═══╝   ╚═╝    ╚═════╝ ╚══════╝

LOGO
printf "${RST}"
printf "${DIM}                     Install TorrentOS to Disk — v${_ver}${RST}\n\n"

# ── Pre-flight checks ────────────────────────────────────────────────────────

if [[ $EUID -ne 0 ]]; then
    err "This installer must run as root. Try: sudo torrentos-install"
    exit 1
fi

step "Checking prerequisites"

# Check archinstall is available
if ! command -v archinstall >/dev/null 2>&1; then
    err "archinstall not found. Install it with: sudo pacman -S archinstall"
    exit 1
fi

# Check jq (needed to build JSON config)
if ! command -v jq >/dev/null 2>&1; then
    err "jq not found. Install it with: sudo pacman -S jq"
    exit 1
fi

log "Checking internet connection..."
_check_internet() { curl -s --max-time 5 https://archlinux.org >/dev/null 2>&1 || curl -s --max-time 5 https://1.1.1.1 >/dev/null 2>&1; }
if _check_internet; then
    ok "Internet reachable."
else
    warn "No internet connection detected."
    echo
    printf "${CYN}  ▸ WiFi Setup${RST}\n"
    echo
    log "Scanning for nearby WiFi networks..."
    nmcli device wifi list 2>/dev/null | head -20 || true
    echo
    printf "${DIM}  Launching network manager (nmtui). Connect to WiFi, then choose Quit.${RST}\n"
    sleep 1
    nmtui 2>/dev/null || true
    echo
    if _check_internet; then
        ok "Internet connected!"
    else
        warn "Still no internet — archinstall needs internet to download packages."
        printf "  Continue anyway? [y/N] "
        read -r ans
        [[ "$ans" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }
    fi
fi

# Check UEFI vs BIOS
if [[ -d /sys/firmware/efi ]]; then
    ok "UEFI firmware detected — GRUB with EFI will be used."
    BOOT_MODE="uefi"
else
    ok "Legacy BIOS detected — GRUB with MBR will be used."
    BOOT_MODE="bios"
fi

# Detect NVIDIA GPU
NVIDIA_DETECTED=false
if lspci 2>/dev/null | grep -qi nvidia; then
    NVIDIA_DETECTED=true
    ok "NVIDIA GPU detected — nvidia-dkms will be installed."
fi

step "Available block devices"
lsblk -o NAME,SIZE,MODEL,TYPE,MOUNTPOINTS -e 7,11 | grep -v "^loop"
echo

printf "${YLW}  ⚠  WARNING: Installation will PERMANENTLY ERASE the selected disk.${RST}\n"
printf "${YLW}     Back up all important data before continuing.${RST}\n"
echo
printf "  Ready to launch the guided installer? [y/N] "
read -r ans
[[ "$ans" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }

# ── Locate local TorrentOS repo ───────────────────────────────────────────────
step "Locating local TorrentOS package repo"
LOCAL_REPO=""
for candidate in \
    "/run/archiso/bootmnt/repo/x86_64" \
    "/run/archiso/airootfs/repo/x86_64" \
    "/repo/x86_64" \
    "/opt/torrentos-repo/x86_64"
do
    if [[ -d "$candidate" ]] && ls "$candidate"/torrentos.db* >/dev/null 2>&1; then
        LOCAL_REPO="$candidate"
        break
    fi
done

# ── Guided account + locale setup ────────────────────────────────────────────
step "Create your user account"
printf "${DIM}  This will be your login on the installed system.${RST}\n\n"

# Username
while true; do
    printf "  ${W}Username${RST} (letters/numbers/underscores, no spaces): "
    read -r NEW_USERNAME
    [[ -z "$NEW_USERNAME" ]] && NEW_USERNAME="user"
    if [[ "$NEW_USERNAME" =~ ^[a-z_][a-z0-9_-]{0,30}$ ]]; then
        break
    fi
    warn "Must start with a lowercase letter and contain only a-z, 0-9, _ or -"
done

# Password (hidden, with confirmation)
while true; do
    printf "  ${W}Password${RST}: "
    read -rs NEW_PASS; echo
    if [[ ${#NEW_PASS} -lt 4 ]]; then
        warn "Password must be at least 4 characters."; continue
    fi
    printf "  ${W}Confirm password${RST}: "
    read -rs NEW_PASS2; echo
    if [[ "$NEW_PASS" == "$NEW_PASS2" ]]; then
        break
    fi
    warn "Passwords don't match — try again."
done

ok "Account: ${NEW_USERNAME}"
echo

step "Timezone"
printf "${DIM}  Common examples:  Europe/London  America/New_York  America/Los_Angeles${RST}\n"
printf "${DIM}                    Europe/Berlin   Asia/Tokyo        Australia/Sydney${RST}\n\n"
printf "  ${W}Timezone${RST} [Europe/London]: "
read -r NEW_TIMEZONE
[[ -z "$NEW_TIMEZONE" ]] && NEW_TIMEZONE="Europe/London"
# Validate — fall back to UTC if unknown
if [[ ! -f "/usr/share/zoneinfo/$NEW_TIMEZONE" ]]; then
    warn "Timezone '$NEW_TIMEZONE' not found — defaulting to Europe/London"
    NEW_TIMEZONE="Europe/London"
fi
ok "Timezone: ${NEW_TIMEZONE}"
echo

# ── Write archinstall config ─────────────────────────────────────────────────
CONF_DIR=$(mktemp -d /tmp/torrentos-install.XXXXX)
trap 'rm -rf "$CONF_DIR"' EXIT

# Additional packages to install on the new system (on top of Desktop/Hyprland)
EXTRA_PACKAGES=(
    # TorrentOS custom packages
    torrentos-base
    torrentos-theme
    torrentos-hyprland-config
    torrentos-first-boot
    torrentos-settings
    torrentos-tools
    # Python deps for settings app
    python
    python-gobject
    python-tomli-w
    # Fonts
    inter-font
    ttf-jetbrains-mono-nerd
    noto-fonts
    noto-fonts-emoji
    # System utils
    libnotify
    pacman-contrib
    papirus-icon-theme
    # Terminal & shell
    ghostty
    zsh
    zsh-completions
    starship
    btop
    htop
    bat
    eza
    fzf
    zoxide
    ripgrep
    fd
    tmux
    fastfetch
    # Desktop components
    waybar
    swaync
    rofi-wayland
    hyprpaper
    hypridle
    hyprlock
    hyprpicker
    nwg-dock-hyprland
    # Media
    playerctl
    pavucontrol
    pipewire
    pipewire-pulse
    pipewire-alsa
    wireplumber
    # Clipboard
    wl-clipboard
    cliphist
    wl-clip-persist
    # Bluetooth
    bluez
    bluez-utils
    blueman
    # Network
    networkmanager
    network-manager-applet
    # Display / colour
    brightnessctl
    gammastep
    # Qt / GTK theming
    qt6ct
    kvantum
    gtk4
    libadwaita
    # Graphics tools
    grim
    slurp
    imv
    loupe              # default image viewer for torrentos-screenshot "Open in Loupe"
    # Files
    nautilus
    file-roller
    # Productivity
    gnome-text-editor
    gnome-calculator
    gnome-font-viewer
    # Gaming
    gamemode
    lib32-gamemode
    mangohud
    lib32-mangohud
    # Flatpak
    flatpak
    # Wayland compat
    xdg-desktop-portal-hyprland
    xdg-user-dirs
    # Accessibility
    magnus
    expac              # package query tool — used by pkgsize alias in .zshrc
    # Browsers & media (default apps per mimeapps.list)
    firefox
    qbittorrent
    mpv
    # Desktop integration
    polkit-gnome          # exec-once polkit auth agent in hyprland.conf
    libinput-gestures     # exec-once libinput-gestures-setup start
    nm-connection-editor  # network settings from waybar
    xdg-desktop-portal-gtk  # file chooser fallback for GTK apps
    # Editor
    neovim                # nvim config deployed by torrentos-hyprland-config
)

# Add NVIDIA packages if detected
if [[ "$NVIDIA_DETECTED" == "true" ]]; then
    EXTRA_PACKAGES+=(
        nvidia-dkms
        nvidia-utils
        lib32-nvidia-utils
        nvidia-settings
        nvidia-prime
        libva-nvidia-driver
    )
fi

# Build additional-repositories JSON block (include local repo if found)
ADD_REPOS="[]"
if [[ -n "$LOCAL_REPO" ]]; then
    ok "Found local TorrentOS repo: $LOCAL_REPO"
    ADD_REPOS="[{\"name\":\"torrentos\",\"url\":\"file://$LOCAL_REPO\",\"sign_check\":\"Never\",\"sign_option\":\"Never\"}]"
else
    warn "Local TorrentOS package repo not found on live media."
    warn "The installer will try to fetch TorrentOS packages from the internet."
    warn "If that fails, run after reboot: sudo pacman -S torrentos-base torrentos-settings ..."
fi

PKG_JSON="$(printf '%s\n' "${EXTRA_PACKAGES[@]}" | jq -R . | jq -s .)"

# Build the user JSON — jq handles special chars in username/password safely
USER_JSON="$(jq -n \
    --arg u "$NEW_USERNAME" \
    --arg p "$NEW_PASS" \
    '[{"username":$u,"!password":$p,"sudo":true,"groups":["wheel","video","audio","input","storage","optical","network","power","sys","tty","lp"]}]')"

# Post-install custom commands (run inside the new system chroot)
CUSTOM_CMDS="[
  \"chsh -s /usr/bin/zsh ${NEW_USERNAME} 2>/dev/null || true\",
  \"systemctl enable NetworkManager 2>/dev/null || true\",
  \"systemctl enable bluetooth 2>/dev/null || true\",
  \"systemctl enable fstrim.timer 2>/dev/null || true\",
  \"systemctl enable systemd-resolved 2>/dev/null || true\",
  \"flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true\",
  \"ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf 2>/dev/null || true\"
]"

# Build graphics driver string
GFX_DRIVER="All open-source (default)"
if [[ "$NVIDIA_DETECTED" == "true" ]]; then
    GFX_DRIVER="Nvidia"
fi

jq -n \
    --argjson repos "$ADD_REPOS" \
    --argjson pkgs "$PKG_JSON" \
    --argjson users "$USER_JSON" \
    --argjson cmds "$CUSTOM_CMDS" \
    --arg tz "$NEW_TIMEZONE" \
    --arg gfx "$GFX_DRIVER" \
'{
  "additional-repositories": $repos,
  "archinstall-language": "English",
  "bootloader": "Grub",
  "hostname": "torrentos",
  "kernels": ["linux"],
  "locale_config": {
    "kb_layout": "us",
    "sys_enc": "UTF-8",
    "sys_lang": "en_US"
  },
  "packages": $pkgs,
  "!users": $users,
  "profile_config": {
    "profile": {
      "custom_settings": {},
      "details": ["Hyprland"],
      "main": "Desktop"
    },
    "gfx_driver": $gfx
  },
  "custom-commands": $cmds,
  "swap": true,
  "timezone": $tz
}' > "$CONF_DIR/user_configuration.json"

# ── Launch archinstall ────────────────────────────────────────────────────────
step "Launching archinstall with TorrentOS defaults"
log "(You will be prompted to choose your disk, user, and password.)"
echo

archinstall --config "$CONF_DIR/user_configuration.json"

# ── Post-install: fix greetd config ──────────────────────────────────────────
# archinstall's built-in Desktop/Hyprland profile writes its own
# /etc/greetd/config.toml inside the chroot (using agreety or its own
# defaults) AFTER packages are installed, which overwrites the correct
# config shipped by torrentos-base.  We stamp the right config here,
# writing directly to the installed system's mountpoint (/mnt).
#
# The correct installed-system config has NO [initial_session] block —
# that block exists only on the live ISO for liveuser autologin.  On an
# installed system liveuser doesn't exist, so [initial_session] would
# cause greetd to crash on every boot.
step "Applying TorrentOS post-install fixes"

INSTALL_MNT="/mnt"
GREETD_DEST="$INSTALL_MNT/etc/greetd/config.toml"

if [[ -d "$INSTALL_MNT/etc/greetd" ]]; then
    log "Writing TorrentOS greetd config to installed system..."
    # --remember-user-session: after first login the username is pre-filled so
    # the user only needs to type their password on every subsequent boot.
    cat > "$GREETD_DEST" << GREETD_EOF
# TorrentOS — greetd configuration for installed systems.
# tuigreet login screen — username is remembered after first login.

[terminal]
vt = 1

[default_session]
command = "tuigreet --time --remember --remember-user-session --asterisks --greeting 'Welcome to TorrentOS — enter your password' --cmd Hyprland"
user = "greeter"
GREETD_EOF
    ok "greetd config written → $GREETD_DEST"

    # Pre-seed tuigreet's state file with the username so it's pre-filled on
    # the very first boot (no login needed first to trigger --remember).
    TUIGREET_STATE="$INSTALL_MNT/var/cache/tuigreet"
    mkdir -p "$TUIGREET_STATE"
    echo "$NEW_USERNAME" > "$TUIGREET_STATE/last_user"
    echo "Hyprland"      > "$TUIGREET_STATE/last_session"
    ok "Login screen pre-seeded with username: ${NEW_USERNAME}"
else
    warn "Could not find installed system at $INSTALL_MNT/etc/greetd — greetd config NOT patched."
    warn "If greetd fails on first boot, run as root on the installed system:"
    warn "  systemctl edit --force greetd"
fi

echo
ok "Installation complete!"
printf "\n  ${GRN}➜${RST}  Remove the live media and reboot to your new system:\n"
printf "\n     ${BLU}reboot${RST}\n\n"
printf "${CYN}  On the login screen your username (${NEW_USERNAME}) will already be filled in.\n"
printf "  Just enter your password and press Enter — every time you boot.${RST}\n\n"
printf "${CYN}  After first login, the TorrentOS setup wizard will guide you\n"
printf "  through WiFi, keyboard layout, timezone, and browser choice.${RST}\n\n"
