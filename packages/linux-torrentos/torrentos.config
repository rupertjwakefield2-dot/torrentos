# TorrentOS kernel configuration fragment
# ============================================================
# Applied on top of x86_64 defconfig via merge_config.sh.
# Only list options that DIFFER from defconfig.
# Format: CONFIG_FOO=y / =n / =m / ="string" / =number
# ============================================================


# ============================================================
# IDENTITY: This kernel belongs to TorrentOS
# uname -r will show: 6.x.y-torrentos
# ============================================================
CONFIG_LOCALVERSION="-torrentos"
CONFIG_LOCALVERSION_AUTO=n


# ============================================================
# SCHEDULER & PREEMPTION
# Full preemption. Not voluntary. Not none. PREEMPT.
# If you want a server kernel, use linux-hardened.
# ============================================================
CONFIG_PREEMPT=y
CONFIG_PREEMPT_VOLUNTARY=n
CONFIG_PREEMPT_NONE=n
# EEVDF (Earliest Eligible Virtual Deadline First) is the scheduler
# since 6.6. It's already the default — just make sure it's on.
CONFIG_SCHED_CLASS_EXT=y


# ============================================================
# TIMER: 1000Hz
# The difference between 300Hz and 1000Hz is measurable in
# input latency benchmarks. Desktop users feel it. Use 1000Hz.
# ============================================================
CONFIG_HZ_1000=y
CONFIG_HZ=1000
# Dynamic tick — idle CPUs don't burn ticks
CONFIG_NO_HZ_IDLE=y
CONFIG_NO_HZ_FULL=n
CONFIG_HZ_PERIODIC=n


# ============================================================
# NETWORKING: BBR — because it's called TorrentOS
# BBR (Bottleneck Bandwidth and RTT) outperforms CUBIC on
# lossy links and long fat networks. It pairs with FQ for
# pacing. This is the only correct choice for a torrent OS.
# ============================================================
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y
# Allow setting qdisc to fq without root (for wireguard, etc.)
CONFIG_NET_SCH_INGRESS=m
CONFIG_NET_CLS_BASIC=m
CONFIG_NET_CLS_FW=m
# MPTCP — multipath TCP. Good for laptops switching between WiFi and LTE.
CONFIG_MPTCP=y
CONFIG_INET_MPTCP_DIAG=m


# ============================================================
# COMPRESSION: ZSTD everywhere
# ZSTD has better decompression speed than XZ, and better
# ratio than LZ4. For a desktop distro, decompression speed
# matters on every boot. This isn't a hard choice.
# ============================================================
# Kernel image compression
CONFIG_KERNEL_ZSTD=y
CONFIG_KERNEL_LZ4=n
CONFIG_KERNEL_XZ=n
CONFIG_KERNEL_GZIP=n
CONFIG_KERNEL_BZIP2=n
CONFIG_KERNEL_LZMA=n
CONFIG_KERNEL_LZO=n
# Module compression
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_COMPRESS_XZ=n
CONFIG_MODULE_COMPRESS_NONE=n


# ============================================================
# MEMORY: Swap compression and transparent huge pages
# zswap saves you from hitting disk swap on memory pressure.
# ZSTD compression + zsmalloc zpool is the right combo.
# ============================================================
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_ZSWAP_ZPOOL_DEFAULT_ZSMALLOC=y
CONFIG_ZSMALLOC=y
CONFIG_Z3FOLD=y
# THP: madvise mode — let apps that benefit opt in, don't force it
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=n
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y


# ============================================================
# CPU FREQUENCY SCALING
# schedutil reads from the scheduler — it knows what the CPU
# is actually doing. performance and powersave are blunt tools.
# ============================================================
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=n
CONFIG_CPU_FREQ_DEFAULT_GOV_POWERSAVE=n
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=m
CONFIG_CPU_FREQ_GOV_USERSPACE=m
# Intel P-state (modern Intel CPUs, more precise than acpi-cpufreq)
CONFIG_X86_INTEL_PSTATE=y
# AMD P-state (Zen 3+ — better power efficiency)
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=3


# ============================================================
# DEBUG: OFF — we ship a distro, not a debugger
# Users don't need 600MB of DWARF info on their disk.
# Developers: rebuild with CONFIG_DEBUG_INFO_DWARF5=y locally.
# ============================================================
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_BTF=n
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=n
CONFIG_DEBUG_INFO_DWARF4=n
CONFIG_DEBUG_INFO_DWARF5=n
CONFIG_DEBUG_KERNEL=n
CONFIG_SLUB_DEBUG=n
CONFIG_PAGE_EXTENSION=n
CONFIG_SCHED_DEBUG=n
CONFIG_DEBUG_PREEMPT=n
CONFIG_LOCK_DEBUGGING_SUPPORT=n
CONFIG_DEBUG_LOCK_ALLOC=n
CONFIG_PROVE_LOCKING=n
CONFIG_DEBUG_SPINLOCK=n
CONFIG_DEBUG_MUTEXES=n
CONFIG_DEBUG_RT_MUTEXES=n
CONFIG_DEBUG_RWSEMS=n
CONFIG_DEBUG_WW_MUTEX_SLOWPATH=n
CONFIG_DEBUG_ATOMIC_SLEEP=n
CONFIG_DEBUG_LIST=n
CONFIG_DEBUG_PLIST=n
CONFIG_DEBUG_SG=n
CONFIG_DEBUG_NOTIFIERS=n
CONFIG_DEBUG_CREDENTIALS=n
CONFIG_KFENCE=n
CONFIG_KASAN=n
CONFIG_UBSAN=n
CONFIG_KCSAN=n
CONFIG_MEMTEST=n


# ============================================================
# FILESYSTEMS: Keep what matters, remove archaeological debris
# ============================================================
# Keep
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_XFS_FS=y
CONFIG_F2FS_FS=y
CONFIG_NTFS3_FS=y
CONFIG_EXFAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_ISO9660_FS=y
CONFIG_UDF_FS=m
# Mac filesystems — needed when booting from or reading Mac drives
CONFIG_HFS_FS=m
CONFIG_HFSPLUS_FS=m

# Remove
CONFIG_REISERFS_FS=n
CONFIG_JFS_FS=n
CONFIG_AFS_FS=n
CONFIG_CODA_FS=n
CONFIG_ROMFS_FS=n
CONFIG_CRAMFS=n
CONFIG_MINIX_FS=n
CONFIG_SYSV_FS=n
CONFIG_UFS_FS=n
CONFIG_NILFS2_FS=n
CONFIG_BEFS_FS=n
CONFIG_BFS_FS=n
CONFIG_QNX4FS_FS=n
CONFIG_QNX6FS_FS=n
CONFIG_ADFS_FS=n
CONFIG_AFFS_FS=n
CONFIG_OMFS_FS=n
CONFIG_OCFS2_FS=n
CONFIG_GFS2_FS=n
CONFIG_9P_FS=m


# ============================================================
# DEAD NETWORK PROTOCOLS — nobody needs these on a desktop
# ============================================================
CONFIG_HAMRADIO=n
CONFIG_ISDN=n
CONFIG_NFC=n
CONFIG_ATM=n
CONFIG_DECNET=n
CONFIG_ECONET=n
CONFIG_WAN=n
CONFIG_PHONET=n
CONFIG_IEEE802154=n
CONFIG_6LOWPAN=n
CONFIG_WPAN_PHY=n


# ============================================================
# PCMCIA / CARDBUS — it's 2026, not 1998
# ============================================================
CONFIG_PCCARD=n
CONFIG_PCMCIA=n
CONFIG_CARDBUS=n


# ============================================================
# APPLE HARDWARE — MacBooks are first-class citizens here
# ============================================================
CONFIG_MACINTOSH_DRIVERS=y
CONFIG_MAC_EMUMOUSEBTN=y
CONFIG_APPLESMC=m
CONFIG_HID_APPLE=m
CONFIG_HID_MAGICMOUSE=m
CONFIG_INPUT_APPLESPI=m
# T2 chip support (2018–2020 Intel MacBooks)
# apple-ibridge is the bridge between the host CPU and T2's iBridge MCU.
# apple-bce (Bridge Communications Extension) gives us keyboard, trackpad, audio.
# Both are upstream in 6.x — they just need to be turned on.
CONFIG_APPLE_IBRIDGE=m
CONFIG_APPLE_BCE=m
# SPI controllers needed for pre-T2 Apple keyboard/trackpad
CONFIG_SPI_PXA2XX=m
CONFIG_SPI_PXA2XX_PCI=m
CONFIG_SPI_INTEL=m
CONFIG_SPI_INTEL_PCI=m
CONFIG_SPI_INTEL_PLATFORM=m


# ============================================================
# GAMING & DESKTOP: futex, io_uring, memfd — all required
# Wine needs futex PI. Wayland compositors need io_uring.
# ============================================================
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y
CONFIG_IO_URING=y
CONFIG_MEMFD_CREATE=y


# ============================================================
# SECURITY: Reasonable hardening, no theater
# ============================================================
CONFIG_PAGE_TABLE_ISOLATION=y
CONFIG_RETPOLINE=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_NONE=y
# AppArmor — Flatpak uses it
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
# SELinux compiled in but not default (don't force it on users)
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y


# ============================================================
# eBPF — not optional anymore
# systemd-oomd, networkd, nftables, bpftrace all use BPF.
# ============================================================
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=n
CONFIG_BPFILTER=y
CONFIG_NET_CLS_BPF=m
CONFIG_NET_ACT_BPF=m
CONFIG_BPF_EVENTS=y
CONFIG_BPF_KPROBE_OVERRIDE=n


# ============================================================
# GPU: We support all three major vendors + Apple
# DKMS handles NVIDIA — the kernel only ships amdgpu + i915 + xe.
# ============================================================
CONFIG_DRM=y
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_NOUVEAU=m
# Wayland requires GEM + prime
CONFIG_DRM_GEM_SHMEM_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
# Simple framebuffer — shows something on screen before DRM loads
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB_SIMPLE=y


# ============================================================
# AUDIO: Modern HDA + USB audio + pipewire-compatible path
# ============================================================
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_ANALOG=m
CONFIG_SND_HDA_CODEC_SIGMATEL=m
CONFIG_SND_HDA_CODEC_VIA=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_CIRRUS=m
# Apple codecs for MacBooks
CONFIG_SND_HDA_CODEC_CS8409=m
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_SOC=y


# ============================================================
# STORAGE: NVMe, SATA, USB — the only three that matter
# ============================================================
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_MULTIPATH=y
CONFIG_NVME_HWMON=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_USB_ATTACHED_SCSI=m
# Trim / DISCARD support — keep your SSDs happy
CONFIG_BLK_DEV_ZONED=y


# ============================================================
# WIRELESS: iwlwifi (Intel), ath11k/ath12k (Qualcomm),
#           mt76 (MediaTek), rtw89 (Realtek), brcmfmac (Broadcom/Apple)
# These five cover every modern laptop WiFi chip.
# ============================================================
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
CONFIG_MT76=m
CONFIG_MT7921E=m
CONFIG_MT7922_COMMON=m
CONFIG_RTW89=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m
# Broadcom brcmfmac — Apple MacBook WiFi on T2 (via apple-bce) and pre-T2
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_USB=m
CONFIG_BRCMFMAC_PCIE=m


# ============================================================
# BLUETOOTH: Full stack — MacBooks, AirPods, peripherals
# ============================================================
CONFIG_BT=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_HIDP=m
CONFIG_BT_LE=y
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_INTEL=m
CONFIG_BT_MTK=m
CONFIG_BT_QCOMSMD=n


# ============================================================
# USB / THUNDERBOLT
# ============================================================
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_THUNDERBOLT=m
CONFIG_USB4=y
CONFIG_USB4_NET=m


# ============================================================
# POWER MANAGEMENT: Laptops need suspend/hibernate
# ============================================================
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y
CONFIG_PM_AUTOSLEEP=y
CONFIG_PM_WAKELOCKS=y
CONFIG_ACPI=y
CONFIG_ACPI_AC=m
CONFIG_ACPI_BATTERY=m
CONFIG_ACPI_FAN=m
CONFIG_ACPI_THERMAL=m
CONFIG_ACPI_VIDEO=m
CONFIG_ACPI_BUTTON=m
CONFIG_ACPI_LID=m
CONFIG_ACPI_DOCK=m
CONFIG_X86_INTEL_LPSS=y
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_MFD_INTEL_LPSS_ACPI=m
# Thermal management — keeps laptops cool without turbo-ing themselves to death
CONFIG_THERMAL=y
CONFIG_THERMAL_HWMON=y
CONFIG_X86_PKG_TEMP_THERMAL=m
CONFIG_INTEL_POWERCLAMP=m
CONFIG_INTEL_RAPL=m


# ============================================================
# INPUT: Trackpads, touchscreens, tablets — all of it
# ============================================================
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYDEV=m
CONFIG_INPUT_TABLET=m
CONFIG_HID_MULTITOUCH=m
CONFIG_TOUCHSCREEN_SYNAPTICS_I2C_RMI=m
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_SYNAPTICS_SMBUS=y
CONFIG_MOUSE_SYNAPTICS_I2C=m
CONFIG_MOUSE_SYNAPTICS_USB=m


# ============================================================
# VIRTUALISATION: We ship docker — keep the virt stack
# ============================================================
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m
CONFIG_VHOST_NET=m
CONFIG_TUN=m
CONFIG_MACVTAP=m
CONFIG_VETH=m
CONFIG_BRIDGE=m
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIRECT=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_MANGLE=m
CONFIG_NF_CONNTRACK=m
CONFIG_NF_CONNTRACK_MARK=y
# iptables compatibility (Docker still uses it)
CONFIG_NETFILTER_XTABLES=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m


# ============================================================
# MISC QUALITY OF LIFE
# ============================================================
# dmi_id — userspace can read DMI/SMBIOS (hwinfo, fwupdmgr need it)
CONFIG_DMI_SYSFS=y
# fwupd firmware updates
CONFIG_EFI_CAPSULE_LOADER=m
# Backlight control (laptops)
CONFIG_BACKLIGHT_CLASS_DEVICE=m
CONFIG_BACKLIGHT_INTEL_PANEL=m
CONFIG_BACKLIGHT_APPLE=m
# LED support (keyboard backlight)
CONFIG_LEDS_CLASS=m
CONFIG_LEDS_DELL_NETBOOKS=n
CONFIG_LEDS_TRIGGER_BACKLIGHT=m
# RTC (don't wake on garbage)
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
# Crypto: hardware acceleration where available
CONFIG_CRYPTO_AES_NI_INTEL=m
CONFIG_CRYPTO_GHASH_CLMUL_NI_INTEL=m
CONFIG_CRYPTO_SHA256_SSSE3=m
CONFIG_CRYPTO_SHA512_SSSE3=m
CONFIG_CRYPTO_ZSTD=y
