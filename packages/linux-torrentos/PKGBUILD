# Maintainer: TorrentOS <packages@torrentos.org>
#
# linux-torrentos — the TorrentOS kernel
#
# We build for ONE use case: desktop and laptop.
# Not servers. Not embedded. Not the radio amateur
# who wants to transmit APRS over ISDN. Desktop. Laptop.
#
# pkgver is updated dynamically by scripts/build-kernel.sh
# before makepkg runs — do not edit pkgver manually.

pkgbase=linux-torrentos
pkgver=6.14.6
pkgrel=1
pkgdesc="TorrentOS kernel — 1000Hz, BBR, ZSTD, full preemption, Apple T2"
arch=('x86_64')
url="https://torrentos.org"
license=('GPL-2.0-only')
makedepends=('bc' 'cpio' 'gettext' 'libelf' 'pahole' 'perl' 'python' 'tar' 'xz' 'zstd')
options=('!strip' '!debug')
_srcname="linux-${pkgver}"

# No GPG (.sign) in source — keys are unavailable in CI containers.
# The tarball is downloaded over HTTPS from kernel.org CDN.
# sha256 is set to SKIP; build-kernel.sh pins an exact pkgver so the
# tarball is deterministic by URL.
source=(
    "https://cdn.kernel.org/pub/linux/kernel/v${pkgver%%.*}.x/${_srcname}.tar.xz"
    'torrentos.config'
    'torrentos.install'
)
sha256sums=('SKIP' 'SKIP' 'SKIP')

prepare() {
    cd "$_srcname"

    echo "==> Base config: x86_64_defconfig"
    make ARCH=x86_64 defconfig

    echo "==> Applying TorrentOS config fragment"
    # merge_config.sh handles Kconfig dependencies correctly.
    # A bare .config edit can leave unsatisfied deps; this tool resolves them.
    scripts/kconfig/merge_config.sh -m .config "$srcdir/torrentos.config"

    echo "==> Resolving new symbols (olddefconfig)"
    make olddefconfig

    echo "==> Config summary (TorrentOS overrides):"
    diff <(cd "$srcdir/$_srcname" && make -s olddefconfig 2>/dev/null && cat .config) .config \
        | grep '^[<>]' | head -40 || true
}

build() {
    cd "$_srcname"
    make -j"$(nproc)" all
}

_package() {
    pkgdesc="${pkgdesc}"
    depends=('coreutils' 'kmod' 'initramfs')
    optdepends=(
        'linux-firmware: firmware for WiFi, GPU, and other devices'
        'sof-firmware: firmware for Intel Sound Open Firmware devices'
    )
    provides=("linux=${pkgver}" "linux-torrentos=${pkgver}")
    install="torrentos.install"

    cd "$_srcname"
    local kernelrelease
    kernelrelease="$(make -s kernelrelease)"
    local modulesdir="$pkgdir/usr/lib/modules/${kernelrelease}"
    local image_name
    image_name="$(make -s image_name)"

    echo "==> Kernel release: ${kernelrelease}"
    echo "==> Image: ${image_name}"

    # Install kernel image to /boot and to the modules dir (for mkinitcpio)
    install -Dm644 "${image_name}" "$pkgdir/boot/vmlinuz-${pkgbase}"
    install -Dm644 "${image_name}" "$modulesdir/vmlinuz"

    # pkgbase file — lets mkinitcpio know which preset to use
    printf '%s\n' "${pkgbase}" | install -Dm644 /dev/stdin "$modulesdir/pkgbase"

    # Install kernel modules
    make INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 \
        DEPMOD=/doesnt/exist modules_install

    # Remove build/source symlinks (they point into the build tree, not the package)
    rm -f "$modulesdir/build" "$modulesdir/source"
}

_package-headers() {
    pkgdesc="Headers and scripts for building modules for ${pkgdesc}"
    depends=('pahole')
    provides=("linux-headers=${pkgver}")

    cd "$_srcname"
    local kernelrelease
    kernelrelease="$(make -s kernelrelease)"
    local builddir="$pkgdir/usr/lib/modules/${kernelrelease}/build"

    echo "==> Installing build files..."
    install -Dt "$builddir" -m644 .config Makefile Module.symvers System.map
    [[ -f version ]] && install -Dt "$builddir" -m644 version
    [[ -f vmlinux ]] && install -m644 vmlinux "$builddir/"
    install -Dt "$builddir/kernel" -m644 kernel/Makefile
    install -Dt "$builddir/arch/x86" -m644 arch/x86/Makefile
    cp -t "$builddir" -a scripts

    # objtool path changed location across kernel versions — find it
    local objtool
    objtool="$(find . -name objtool -perm /111 -type f | head -1)"
    [[ -n "$objtool" ]] && install -Dt "$builddir/${objtool%/*}" "$objtool"

    echo "==> Installing Kconfig and Kbuild files..."
    while IFS= read -r -d '' file; do
        local dir="$builddir/${file%/*}"
        mkdir -p "$dir"
        install -m644 "$file" "$dir/"
    done < <(find . \( -name 'Kbuild' -o -name 'Kconfig' -o -name 'Kconfig.*' \) -print0)

    echo "==> Installing headers..."
    cp -t "$builddir" -a include
    cp -t "$builddir/arch/x86" -a arch/x86/include
    install -Dt "$builddir/arch/x86/kernel" -m644 arch/x86/kernel/asm-offsets.s

    # Install media driver headers (needed for some out-of-tree modules)
    for dir in \
        drivers/md \
        net/mac80211 \
        drivers/media/i2c \
        drivers/media/usb/dvb-usb \
        drivers/media/dvb-frontends \
        drivers/media/tuners \
        drivers/iio/common/hid-sensors; do
        [[ -d "$dir" ]] || continue
        local dest="$builddir/$dir"
        mkdir -p "$dest"
        find "$dir" -maxdepth 1 -name '*.h' -exec install -m644 {} "$dest/" \;
    done

    echo "==> Removing non-x86 arch directories..."
    find "$builddir/arch" -mindepth 1 -maxdepth 1 ! -name x86 -exec rm -rf {} +

    echo "==> Removing build objects..."
    find "$builddir" -type f -name '*.o' -delete

    echo "==> Creating /usr/src symlink..."
    mkdir -p "$pkgdir/usr/src"
    ln -sr "$builddir" "$pkgdir/usr/src/${pkgbase}"
}

# Generate package_linux-torrentos() and package_linux-torrentos-headers()
# from the _package() and _package-headers() functions above.
pkgname=("${pkgbase}" "${pkgbase}-headers")
for _p in "${pkgname[@]}"; do
    eval "package_${_p}() {
        $(declare -f "_package${_p#"${pkgbase}"}")
        _package${_p#"${pkgbase}"}
    }"
done
